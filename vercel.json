{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://vidvault-s7kv.onrender.com/api/$1"
    },
    {
      "source": "/downloads/(.*)",
      "destination": "https://vidvault-s7kv.onrender.com/downloads/$1"
    },
    {
      "source": "/((?!api/|downloads/).*)",
      "destination": "/index.html"
    }
  ]
}
